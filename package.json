{
  "name": "claude-squad",
  "version": "0.1.0",
  "description": "A terminal multi-agent workspace: talk to a squad of Claude agents in tabs, and let them coordinate in a groupchat.",
  "type": "module",
  "bin": {
    "squad": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx src/dev/smoke.ts",
    "integration": "tsx src/dev/integration.ts",
    "capabilities": "tsx src/dev/capability-e2e.ts",
    "reconfig": "tsx src/dev/reconfig-e2e.ts",
    "context": "tsx src/dev/context-e2e.ts",
    "mentions": "tsx src/dev/mention-e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.268",
    "@inkjs/ui": "^2.0.0",
    "gray-matter": "^4.0.3",
    "ink": "^7.1.1",
    "react": "^19.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
